{
  "name": "pikadex",
  "version": "1.0.0",
  "description": "Pokedex progressive web app with nextjs + bootstrap",
  "author": "Antonio Marin",
  "license": "MIT",
  "keywords": [
    "react",
    "next",
    "pwa",
    "progressive",
    "progressive web app",
    "web",
    "app",
    "react",
    "bootstrap",
    "pokedex",
    "pokemon"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development next",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "test": "cross-env NODE_ENV=test jest",
    "analyze": "cross-env NODE_ENV=production ANALYZE=1 next build",
    "lint": "eslint --fix . --ignore-path ./.gitignore",
    "format": "prettier --write './**/*.{js,jsx,scss,md,json}' --config ./.prettierrc --ignore-path ./.gitignore"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "husky": {
    "hooks": {
      "pre-commit": "echo \"npm run format && npm run lint && npm run test\""
    }
  },
  "dependencies": {
    "animejs": "^3.2.1",
    "autosuggest-highlight": "^3.3.4",
    "bootstrap": "^5.3.3",
    "bootswatch": "^5.3.3",
    "hammerjs": "^2.0.8",
    "i18next": "23.16.8",
    "next": "15.3.8",
    "next-i18next": "15.3.1",
    "next-pwa": "5.6.0",
    "pokedex-promise-v2": "4.1.1",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-autosuggest": "10.1.0",
    "react-bootstrap": "2.10.6",
    "react-dom": "18.3.1",
    "react-i18next": "15.2.0",
    "sass": "1.80.5",
    "swr": "2.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/register": "^7.25.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "babel-jest": "^29.7.0",
    "codecov": "^3.8.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.2"
  }
}
